# ========================================================
# TotalDrive - Variáveis de Ambiente (Google OAuth 2.0)
# ========================================================

# Porta onde o servidor Node.js irá rodar
PORT=3000

# Client ID gerado no Google Cloud Console
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com

# Client Secret gerado no Google Cloud Console
GOOGLE_CLIENT_SECRET=GOCSPX-seu_client_secret_aqui

# URI de Redirecionamento autorizada (deve ser idêntica à configurada no Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
